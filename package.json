{
  "scripts": {
    "lint:contract": ".venv/bin/genvm-lint lint contracts/content_bounty.py",
    "check:contract": "bash scripts/check_contract.sh",
    "test:contract": ".venv/bin/pytest tests/direct -v",
    "test:evidence": ".venv/bin/pytest tests/unit/test_prepare_evidence.py -v",
    "test:network": "node --test tests/js/network_selection.test.mjs tests/js/live_proof_mode.test.mjs tests/js/frontend_bundle.test.mjs tests/js/deployer_guard.test.mjs",
    "test:lifecycle": "node --test tests/js/live_lifecycle.test.mjs tests/js/live_proof_store.test.mjs tests/js/live_adversarial_fixture.test.mjs tests/js/live_deployment_recovery.test.mjs tests/js/live_run_preflight.test.mjs tests/js/live_mutation_state.test.mjs tests/js/live_scenario_recovery.test.mjs tests/js/live_provenance.test.mjs",
    "test:hosting": "node --test tests/js/live_evidence_worker.test.mjs",
    "test:live": "node tests/integration/live_consensus.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "verify:frontend-bundle": "node scripts/verify_frontend_bundle.mjs frontend/dist"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "js-yaml": "4.3.1",
    "viem": "2.55.11",
    "ws": "8.21.0",
    "ox": "0.14.33"
  }
}
