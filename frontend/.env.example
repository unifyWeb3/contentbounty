# Required: deploy contracts/content_bounty.py v2 and record the finalized address.
VITE_CONTRACT_ADDRESS=

# Supported values: studionet, testnetAsimov, testnetBradbury.
# The default is studionet. RPC, explorer, chain ID, and consensus contracts
# always come from the selected official genlayer-js chain object. Before every
# write the app verifies consensus code, the official ABI probe, and (for shared
# chain ID 4221) recent block identity against this selected network's RPC.
VITE_GENLAYER_NETWORK=studionet
