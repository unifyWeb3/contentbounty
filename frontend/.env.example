# Required: deploy contracts/content_bounty.py v2 and record the finalized address.
VITE_CONTRACT_ADDRESS=

# Supported values: studionet or testnetBradbury.
# The default is studionet smoke/demo mode. RPC, explorer, chain ID, and
# consensus contracts always come from the selected official genlayer-js chain
# object. Persistent production proof uses testnetBradbury only.
VITE_GENLAYER_NETWORK=studionet
